# Backend Environment Variables
DATABASE_URL=your_neon_database_url_here
PORT=3000
NODE_ENV=production
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,https://www.your-domain.com

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# For production: https://your-backend-domain.vercel.app/api/auth/google/callback

# Session Secret (generate a random string)
SESSION_SECRET=your_random_session_secret_here

# JWT Secret for token-based authentication (generate a random string)
# If not set, SESSION_SECRET will be used as fallback
JWT_SECRET=your_random_jwt_secret_here

# JWT Token Expiry (default: 7d)
JWT_EXPIRY=7d

# Frontend URL for OAuth redirects
FRONTEND_URL=http://localhost:5173
# For production: https://your-frontend-domain.vercel.app

# Private Cloudflare R2 receipt storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=private-receipts
# Recorded for deployment configuration only; receipts are never served from this URL.
R2_PUBLIC_URL=https://receipts.example.com

# Optional receipt scanning (hidden when unset)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Monthly settlement digest
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=Expense Manager <settlements@example.com>
DIGEST_SECRET=your_random_digest_secret
